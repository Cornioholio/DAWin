<Window x:Class="DAWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DAWin"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- Layout rows -->
        <Grid.RowDefinitions>
            <!-- Top Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Resizing Splitter Handle -->
            <RowDefinition Height="Auto" />
            <!-- Bottom Console Panel -->
            <RowDefinition Height="150" MinHeight="60" MaxHeight="400" />
        </Grid.RowDefinitions>

        <!-- Main Workspace-->
        <Grid Grid.Row="0" Background="#FFFFFF">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="DAWin Workspace" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" />
                <ComboBox x:Name="AudioDeviceCB" DisplayMemberPath="DeviceName"/>
                <!-- Button to create device -->
                <Button Content="Initialize Device" 
                    Width="150" 
                    Height="40" 
                    Background="#007ACC" 
                    Foreground="White"
                    Click="InitializeDevice_Click"/>
                <!-- Redetect audio devices -->
                <Button Content="Detect Devices" 
                    Width="150" 
                    Height="40" 
                    Background="#007ACC" 
                    Foreground="White"
                    Click="DetectDevices_Click"/>
            </StackPanel>
        </Grid>

        <!-- Splitter Handle -->
        <GridSplitter Grid.Row="1" 
                  Height="5" 
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Center" 
                  Background="#CCCCCC"
                  ResizeBehavior="PreviousAndNext" 
                  ResizeDirection="Rows"/>

        <!-- Console Panel -->
        <Grid Grid.Row="2" Background="#1E1E1E">
            <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10,10,80,10">
                <TextBlock x:Name="ConsoleOutput" 
                       Text="Console Initialized..." 
                       FontFamily="Consolas" 
                       FontSize="12" 
                       Foreground="White" 
                       TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- Button to clear console log -->
            <Button Content="Clear" 
                Width="60" 
                Height="25" 
                Margin="10"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Background="#333333" 
                Foreground="#FFFFFF"
                Click="ClearConsole_Click"/>
        </Grid>
    </Grid>
</Window>
